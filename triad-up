#!/bin/sh
# triad-up — start / restart this copy of the armour proxy.
#
# Portable by design: every path is derived from THIS file's location, so the
# whole directory can be copied anywhere (another phone, a container, a laptop)
# and it will read its own policy, keys, state, logs and artifacts. Nothing is
# hard-coded to a particular install path and nothing outside this directory is
# read, written, restarted or signalled.
#
# Usage:
#   triad-up            start (or report status when already running)
#   triad-up --restart  restart after editing blocks/ or policy
#   triad-up --status   status only
set -e
DIR=$(cd "$(dirname "$0")" && pwd)
PORT=${TRIAD_PORT:-8412}
# EPHEMERAL: no log file at all. The proxy's own output is a system-level
# record (startup, model table, errors) — never the conversation — but on a
# shared host even that should not accumulate, and the operator reads it from
# `journalctl` or the foreground anyway. Redirect to /dev/null so nothing is
# created on disk.
if [ "${ARMOR_EPHEMERAL:-0}" = "1" ]; then
  LOG=/dev/null
  mkdir -p "$DIR/runtime/state" "$DIR/artifacts" "$DIR/state"
else
  LOG=$DIR/logs/triad.log
  mkdir -p "$DIR/logs" "$DIR/runtime/state" "$DIR/runtime/trace" "$DIR/artifacts" "$DIR/state"
fi

status() {
  if [ -f "$DIR/triad.pid" ]; then
    PID=$(cat "$DIR/triad.pid")
    if kill -0 "$PID" 2>/dev/null; then
      N=$(ps -o args= -p "$PID" 2>/dev/null | head -1)
      echo "running pid=$PID port=$PORT"
      echo "  $N"
      echo -n "  healthz: "
      curl -s -m 3 "http://127.0.0.1:$PORT/healthz" || echo "(no response)"
      echo
      return 0
    fi
  fi
  echo "not running"
  return 1
}

case "$1" in
  --status) status; exit $? ;;
  --restart)
    PIDF="$DIR/triad.pid"
    if [ -f "$PIDF" ]; then
      OLD=$(cat "$PIDF" 2>/dev/null || true)
      kill "$OLD" 2>/dev/null || true
      # Wait for the old process to actually release the port. A fixed 0.6 s
      # sleep was shorter than the proxy's own 6 s drain, so a restart with
      # in-flight requests bound failed (`Address in use`), the old process then
      # exited too, and the install was left with no process and a pidfile
      # pointing at a dead pid — measured 2026-11-06.
      i=0
      while [ $i -lt 150 ]; do
        kill -0 "$OLD" 2>/dev/null || break
        i=$((i + 1))
        sleep 0.2
      done
      if kill -0 "$OLD" 2>/dev/null; then
        echo "drain timed out after 30s; forcing $OLD" >&2
        kill -9 "$OLD" 2>/dev/null || true
        sleep 0.5
      fi
      # The port must be free before the new process binds. Listening is what
      # matters, not process death: a dying process can hold the socket a
      # moment longer.
      j=0
      while [ $j -lt 50 ]; do
        if ! curl -s -m 1 "http://127.0.0.1:$PORT/healthz" >/dev/null 2>&1; then
          break
        fi
        j=$((j + 1))
        sleep 0.2
      done
    fi
    ;;
  "") if status >/dev/null 2>&1; then status; exit 0; fi ;;
  *) echo "usage: triad-up [--restart|--status]" >&2; exit 2 ;;
esac

cd "$DIR"
env \
  ARMOR_PROXY_PORT="$PORT" \
  ARMOR_BIND=127.0.0.1 \
  ARMOR_BASE="$DIR" \
  ARMOR_MAP_FILE="$DIR/policy/source/armor_map_active.json" \
  ARMOR_ALIAS_FILE="$DIR/policy/source/armor_alias.json" \
  ARMOR_KEY_POOL="$DIR/proxy/upstream_keys.txt" \
  ARMOR_CLIENT_KEYS="$DIR/proxy/client_keys.txt" \
  ARMOR_STATE_FILE="$DIR/runtime/state/session_state.json" \
  ARMOR_ARCHIVE_DIR="$DIR/runtime/state" \
  ARMOR_LOG_DIR="$DIR/logs" \
  ARMOR_PANEL_FILE="$DIR/proxy/panel_settings.json" \
  ARMOR_MEDIA_DIR="$DIR/media" \
  ARMOR_PARAMS=1 ARMOR_REFRAME=1 \
  ARMOR_STATE=0 ARMOR_ARCHIVE=0 \
  ARMOR_LEVEL="${ARMOR_LEVEL:-native}" \
  nohup python3 "$DIR/armor_proxy.py" >> "$LOG" 2>&1 &
echo $! > "$DIR/triad.pid"
sleep 1.4
status
