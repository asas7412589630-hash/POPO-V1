#!/bin/sh
# triad-tunnel — expose THIS copy (8412) on a public URL, and only this copy.
#
# Same fix as the original tunnel-up: the log is cumulative across restarts, so
# scanning it with `tail -1` returns the previous (dead) hostname while the new
# one has not been printed yet. That is how a client ends up with "Service
# temporarily unavailable" against a perfectly healthy proxy. Here the log is
# per-start (offset recorded before launch) and the hostname is validated
# (DNS + /healthz) before it is written to tunnel_url.txt.
set -e
DIR=$(cd "$(dirname "$0")" && pwd)
LOG=$DIR/logs/tunnel.log
URLF=$DIR/tunnel_url.txt
PIDF=$DIR/tunnel.pid
# cloudflared is looked up on PATH, then in ./bin — no absolute path is
# baked in, so this directory stays portable. Set CLOUDFLARED to override.
BIN=${CLOUDFLARED:-}
if [ -z "$BIN" ]; then
  for c in "$DIR/bin/cloudflared" \
         "$(command -v cloudflared 2>/dev/null || true)" \
         "$DIR/../armor_lib/proxy/bin/cloudflared" \
         "$HOME/cloudflared" "/usr/local/bin/cloudflared" "/usr/bin/cloudflared"; do
    [ -n "$c" ] && [ -x "$c" ] && BIN=$c && break
  done
fi
PORT=${TRIAD_PORT:-8412}

alive() {
  [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null
}

show_url() {
  [ -f "$URLF" ] && cat "$URLF" || echo "(no url yet)"
}

case "$1" in
  --status)
    if alive; then echo "tunnel running pid=$(cat "$PIDF")"; show_url; else echo "tunnel not running"; fi
    exit 0 ;;
  --down)
    [ -f "$PIDF" ] && kill "$(cat "$PIDF")" 2>/dev/null || true
    rm -f "$PIDF" "$URLF"
    echo "tunnel down"; exit 0 ;;
  --restart)
    [ -f "$PIDF" ] && kill "$(cat "$PIDF")" 2>/dev/null || true
    sleep 0.6; rm -f "$URLF" ;;
  "") if alive; then echo "tunnel already up"; show_url; exit 0; fi ;;
  *) echo "usage: triad-tunnel [--restart|--status|--down]" >&2; exit 2 ;;
esac

mkdir -p "$DIR/logs"
touch "$LOG"
MARK=$(wc -l < "$LOG")
nohup "$BIN" tunnel --no-autoupdate --protocol http2 \
      --url "http://127.0.0.1:$PORT" >> "$LOG" 2>&1 &
echo $! > "$PIDF"

# Wait for a hostname that APPEARS AFTER this start and actually answers.
i=0
while [ "$i" -lt 60 ]; do
  i=$((i+1))
  sleep 1
  # Only lines written by this run.
  CAND=$(tail -n +$((MARK+1)) "$LOG" 2>/dev/null \
         | grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' | tail -1)
  [ -z "$CAND" ] && continue
  HOST=$(echo "$CAND" | sed 's|https://||')
  # Validate before publishing: a hostname that does not resolve, or a proxy
  # that does not answer, must never reach tunnel_url.txt.
  if getent hosts "$HOST" >/dev/null 2>&1; then
    if curl -fsS -m 6 "$CAND/healthz" >/dev/null 2>&1; then
      echo "$CAND" > "$URLF"
      echo "URL: $CAND"
      echo "APP: $CAND/app/"
      exit 0
    fi
  fi
done

echo "tunnel started but no validated url yet (see $LOG)" >&2
exit 1
