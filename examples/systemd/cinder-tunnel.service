[Unit]
Description=Cinder tunnel (public URL via cloudflared)
Documentation=https://github.com/yuangeluyou/cinder-server
After=network-online.target cinder-proxy.service
Wants=network-online.target

[Service]
Type=simple

# CHANGE THESE before enabling:
User=ubuntu
WorkingDirectory=/home/ubuntu/cinder-server

Environment=TRIAD_PORT=8412

# triad-tunnel re-publishes the hostname on every start and validates it (DNS +
# /healthz) before writing tunnel_url.txt. A quick tunnel changes its URL each
# restart; serving the cached one is what makes a client report "service
# unavailable" against a healthy proxy.
ExecStart=/home/ubuntu/cinder-server/triad-tunnel

Restart=always
RestartSec=10

# A quick tunnel exits non-zero when cloudflared is not on PATH. Restarting every
# 10 s forever is noise; give it a few chances then stop.
StartLimitBurst=5
StartLimitIntervalSec=120

NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cinder-tunnel

[Install]
WantedBy=multi-user.target
