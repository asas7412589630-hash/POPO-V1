[Unit]
Description=Cinder proxy (local armour proxy)
Documentation=https://github.com/yuangeluyou/cinder-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# CHANGE THESE TWO before enabling:
User=ubuntu
WorkingDirectory=/home/ubuntu/cinder-server

Environment=TRIAD_PORT=8412
Environment=ARMOR_BIND=127.0.0.1

# Ephemeral: nothing is written to disk. Flip to 0 for logs and archives.
Environment=ARMOR_EPHEMERAL=1

# Optional: override the outbound User-Agent. Useful when a shared host's egress
# IP is on a WAF list and a library UA gets the request blocked before it reaches
# the model. Uncomment and set your own.
#Environment=ARMOR_UPSTREAM_UA=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

ExecStart=/home/ubuntu/cinder-server/run-proxy.sh

Restart=always
RestartSec=3

# The proxy drains in-flight requests on SIGTERM before exiting. 15 s covers the
# default 6 s grace plus a slow stream.
TimeoutStopSec=15
KillSignal=SIGTERM

# Hardening. The proxy needs to read its own tree and, in ephemeral mode, write
# nothing; in persistent mode it writes proxy/ and logs/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/cinder-server/proxy /home/ubuntu/cinder-server/logs /home/ubuntu/cinder-server/state

# journald captures stdout/stderr; in ephemeral mode that is the ONLY record.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cinder-proxy

[Install]
WantedBy=multi-user.target
